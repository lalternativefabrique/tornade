FROM rust:1.93-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends libmp3lame-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY apps/tts/ apps/tts/
RUN cd apps/tts && cargo build --release -p tornade-tts && cp target/release/tornade-tts /out-tornade-tts

FROM debian:bookworm-slim
# The upgrade takes the base's libpcre2 past CVE-2026-86145 and CVE-2026-89161,
# which the publish scan refuses.
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates libmp3lame0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r tts && useradd -r -g tts -d /home/tts -m tts
COPY --from=build /out-tornade-tts /usr/local/bin/tornade-tts
# The model config files are read from the source tree at runtime.
COPY --from=build /src/apps/tts/crates/engine/config /app/config
USER tts
ENV HF_HOME=/home/tts/.cache/huggingface \
    TTS_CONFIG_DIR=/app/config \
    LISTEN_ADDR=0.0.0.0:5000
EXPOSE 5000
ENTRYPOINT ["tornade-tts"]
